  },
  "homepage": "https://github.com/caimc21069065-prog/dsh-shared-session#readme",
  "bugs": {
    "url": "https://github.com/caimc21069065-prog/dsh-shared-session/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "zcode",
    "shared-session",
    "pair-programming",
    "collaboration"
  ],
  "scripts": {
    "test": "node plugins/dsh-shared-session/test/e2e.mjs"
  },
  "dsh": {
    "bundle": {
